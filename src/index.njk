---
title: "Gastro Einkaufsgemeinschaft – Ihr starker Partner für den Gastronomieeinkauf"
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="Mit unserer Einkaufsgemeinschaft sparen Sie garantiert 5 Prozent. Hohe Rückvergütungen ohne versteckte Gebühren – seit 2006.">
  <meta name="theme-color" content="#14110d">
  <link rel="icon" href="/images/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/favicon-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@300..900&display=swap" rel="stylesheet">
  <link rel="preload" as="image" href="/images/hero/hero-1.webp">
  <link rel="stylesheet" href="/css/style.css?v={% assetHash 'src/css/style.css' %}">
</head>
<body>

<a class="skip" href="#content">Zum Inhalt springen</a>

<!-- ============ HEADER ============ -->
<header class="hdr" data-hdr>
  <div class="hdr__bar">
    <a href="/" class="hdr__logo" aria-label="Gastro Einkaufsgemeinschaft – Startseite">
      <img src="/images/logo-white.png" alt="Gastro Einkaufsgemeinschaft" width="500" height="208">
    </a>
    <nav class="hdr__nav" aria-label="Hauptnavigation">
      <a href="/#ueber-uns">Über uns</a>
      <a href="/#vorteile">Vorteile</a>
      <a href="/#leistungen">Leistungen</a>
      <a href="/#kontakt">Kontakt</a>
    </nav>
    <a href="{{ site.funnel }}" class="btn btn--orange btn--sm hdr__cta">Potenzialanalyse <span class="btn__arrow" aria-hidden="true">→</span></a>
    <button class="hdr__burger" aria-label="Menü öffnen" aria-expanded="false" data-burger><span></span><span></span></button>
  </div>
</header>

<div class="mnav" data-mnav aria-hidden="true">
  <nav aria-label="Mobile Navigation">
    <a href="/#ueber-uns"><small>01</small>Über uns</a>
    <a href="/#vorteile"><small>02</small>Vorteile</a>
    <a href="/#leistungen"><small>03</small>Leistungen</a>
    <a href="/#kontakt"><small>04</small>Kontakt</a>
  </nav>
  <a href="{{ site.funnel }}" class="btn btn--orange">Kostenfreie Potenzialanalyse vereinbaren</a>
  <a href="tel:{{ site.phone }}" class="mnav__tel">{{ site.phoneLabel }}</a>
</div>

<main id="content">

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <div class="hero__img" style="background-image:url(/images/hero/hero-1.webp)"></div>
    <div class="hero__img" style="background-image:url(/images/hero/hero-2.webp)"></div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <p class="eyebrow eyebrow--light" data-rise><span class="dot"></span>SEIT 2006</p>
    <h1 class="hero__title" data-rise style="--d:.08s">
      Ihr starker Partner für den <em>Gastronomieeinkauf</em>
    </h1>
    <div class="hero__lead" data-rise style="--d:.18s">
      <p class="hero__q">Wie kann ich im Gastronomieeinkauf Kosten senken?</p>
      <p>Mit unserer Einkaufsgemeinschaft sparen Sie garantiert 5&nbsp;Prozent. Sie profitieren von hohen Rückvergütungen ohne versteckte Gebühren, wodurch Sie gleichzeitig Geld sparen und wertvolle Zeit für Ihren Betrieb gewinnen.</p>
    </div>
    <div class="hero__actions" data-rise style="--d:.28s">
      <a href="/#vorteile" class="btn btn--orange">Mitglied werden <span class="btn__arrow" aria-hidden="true">→</span></a>
      <a href="/#vorteile" class="btn btn--ghost">Mehr Infos</a>
    </div>
  </div>

  <div class="hero__stamp" aria-hidden="true">
    <svg viewBox="0 0 200 200">
      <defs><path id="circ" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
      <text><textPath href="#circ" textLength="486" lengthAdjust="spacing">GARANTIERT SPAREN · OHNE GEBÜHREN · SEIT 2006 ·</textPath></text>
    </svg>
    <span class="hero__stamp-num">5<small>%</small></span>
  </div>

  <div class="wrap hero__stats">
    <div class="stats">
      <div class="stat"><span class="stat__num"><span data-count="450">0</span><i>+</i></span><span class="stat__label">Gastronomen</span></div>
      <div class="stat"><span class="stat__num"><span data-count="150">0</span><i>+</i></span><span class="stat__label">Autohöfe und Tankstellen</span></div>
      <div class="stat"><span class="stat__num"><span data-count="19">0</span><i>+</i></span><span class="stat__label">Jahre auf dem Markt</span></div>
      <div class="stat"><span class="stat__num"><span data-count="50">0</span><i>+</i></span><span class="stat__label">Ausgewählte Lieferanten</span></div>
    </div>
  </div>
</section>

<!-- ============ PARTNER-LOGOS ============ -->
<section class="logos" aria-label="Unsere Partner und Lieferanten">
  {% set half = (partners.length / 2) | round(0, "ceil") %}
  <div class="logos__row">
    <div class="logos__track">
      {% for rep in [1, 2] %}{% for l in partners | batch(half) | first %}
      <div class="logo-tile"{% if rep == 2 %} aria-hidden="true"{% endif %}><img src="/images/partner/{{ l }}" alt="" loading="lazy" width="500" height="300"></div>
      {% endfor %}{% endfor %}
    </div>
  </div>
  <div class="logos__row logos__row--rev">
    <div class="logos__track">
      {% for rep in [1, 2] %}{% for l in partners | batch(half) | last %}
      <div class="logo-tile"{% if rep == 2 %} aria-hidden="true"{% endif %}><img src="/images/partner/{{ l }}" alt="" loading="lazy" width="500" height="300"></div>
      {% endfor %}{% endfor %}
    </div>
  </div>
</section>

<!-- ============ ÜBER UNS / CTA + VIDEO ============ -->
<section class="intro" id="ueber-uns">
  <div class="wrap intro__grid">
    <div class="intro__text" data-reveal>
      <h2 class="h2">Beim Gastro-Einkauf garantiert <span class="hl-green">5&nbsp;Prozent</span> sparen? Wie das geht, besprechen wir am besten direkt.</h2>
      <p class="lead">Lohnt sich eine Einkaufsgemeinschaft für mich? In einer kostenfreien Potenzialanalyse finden wir gemeinsam heraus, wie viel Sie konkret sparen können. Vereinbaren Sie jetzt ein persönliches Telefonat.</p>
      <a href="{{ site.funnel }}" class="btn btn--green">Kostenfreie Potenzialanalyse vereinbaren <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="intro__video" data-reveal style="--d:.1s">
      <div class="vplayer" data-vplayer>
        <video src="{{ site.videoBase }}/2025/07/kaykossak.mp4#t=4" preload="metadata" playsinline></video>
        <button class="vplayer__btn" aria-label="Video abspielen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></button>
      </div>
    </div>
  </div>

  <div class="wrap">
    <ul class="facts" data-reveal>
      <li>
        <span class="facts__k">Nr. 1</span><span class="facts__l">in der Verkehrsgastronomie</span>
        <span class="facts__img"><img src="/images/fakt-1.webp" alt="Tankstelle" width="700" height="700" loading="lazy"></span>
      </li>
      <li>
        <span class="facts__k">400</span><span class="facts__l">Gastronomiepartner</span>
        <span class="facts__img"><img src="/images/fakt-2.webp" alt="Zwei Gastronomen in der Küche" width="700" height="700" loading="lazy"></span>
      </li>
      <li>
        <span class="facts__k">100</span><span class="facts__l">Autohöfe/Raststätten</span>
        <span class="facts__img"><img src="/images/fakt-3.webp" alt="Autohof aus der Luft" width="700" height="700" loading="lazy"></span>
      </li>
    </ul>
  </div>
</section>

<!-- ============ VORTEILE ============ -->
<section class="adv" id="vorteile">
 <div class="adv__pin" data-adv-pin>
 <div class="adv__sticky">
  <div class="wrap">
    <div class="adv__head">
      <p class="eyebrow"><span class="dot"></span>Ihre Vorteile</p>
    </div>

    <div class="adv__grid">
      <div class="adv__visual" aria-hidden="true">
        <div class="adv__frame">
          <img src="/images/vorteil-1.webp" alt="" class="is-active" data-adv-img="0" width="2000" height="1493" style="object-position: 68% 50%">
          <img src="/images/vorteil-2.webp" alt="" data-adv-img="1" width="2000" height="1493" loading="lazy" style="object-position: 58% 50%">
          <img src="/images/vorteil-3.webp" alt="" data-adv-img="2" width="2000" height="1493" loading="lazy" style="object-position: 88% 50%">
          <span class="adv__counter"><b data-adv-num>01</b> / 03</span>
        </div>
      </div>

      <div class="adv__steps">
        <article class="adv__step" data-adv-step="0">
          <img src="/images/vorteil-1.webp" alt="" class="adv__mimg" width="2000" height="1493" loading="lazy" style="object-position: 68% 50%">
          <span class="adv__no">01</span>
          <p class="eyebrow eyebrow--sm">Ihre Vorteile</p>
          <h2 class="h2">Hohe Rückvergütung – keine Gebühren</h2>
          <p class="lead">Warum lohnt sich die Mitgliedschaft? Wir garantieren hohe Rückvergütungen und stabile Einkaufspreise. Dabei verzichten wir komplett auf Aufnahmegebühren oder versteckte Kosten, um Ihre Marge direkt zu steigern.</p>
          <p>Wir wissen, dass die Gemeinschaft uns stark macht. Mit jedem neuen Mitglied wächst unsere Basis für die Verhandlungen mit unseren Partnern. Dieses Bewusstsein geben wir an unsere Mitglieder weiter: Sie überzeugt die hohe Rückvergütung, es gibt bei uns weder versteckte Kosten noch eine Aufnahmegebühr. Wir verdienen unser Geld mit dem, was wir können und lieben: Verhandeln, Qualität sichern, dauerhafte Geschäftsbeziehungen zu Lieferanten und Partnern aufbauen und halten.</p>
        </article>

        <article class="adv__step" data-adv-step="1">
          <img src="/images/vorteil-2.webp" alt="" class="adv__mimg" width="2000" height="1493" loading="lazy" style="object-position: 58% 50%">
          <span class="adv__no">02</span>
          <p class="eyebrow eyebrow--sm">Ihre Vorteile</p>
          <h2 class="h2">Geld sparen &amp; Zeit gewinnen</h2>
          <p>Unsere Mitglieder sparen im Einkauf bares Geld, das wir 1:1 an sie zurückgeben. Das ermöglichen wir durch die herausragenden Einkaufskonditionen, die wir mit unseren Partnern und Lieferanten verhandeln. Wie viel Zeit der Einkauf kostet, wissen unsere Mitglieder am besten. Wie sparen Gastronomen Zeit beim Einkauf? Durch die Auslagerung der Preisverhandlungen an uns gewinnen Sie Zeit für Ihr Kerngeschäft: die Bewirtung Ihrer Gäste und die Optimierung Ihres Betriebs. Die Mitgliedschaft in unserer Einkaufsgemeinschaft spart Geld und Zeit und bringt so doppelt Gewinn.</p>
        </article>

        <article class="adv__step" data-adv-step="2">
          <img src="/images/vorteil-3.webp" alt="" class="adv__mimg" width="2000" height="1493" loading="lazy" style="object-position: 88% 50%">
          <span class="adv__no">03</span>
          <p class="eyebrow eyebrow--sm">Ihre Vorteile</p>
          <h2 class="h2">3 x TOP: Lieferanten, Qualität, Ordersätze</h2>
          <p class="lead">Die Gastro Einkaufsgemeinschaft steht für eine hohe Rückvergütung und stabile Preise für unsere Mitglieder. Und das ohne Aufnahmegebühr oder versteckte Kosten.</p>
          <p>Wir wissen, dass die Gemeinschaft uns stark macht. Mit jedem neuen Mitglied wächst unsere Basis für die Verhandlungen mit unseren Partnern. Dieses Bewusstsein geben wir an unsere Mitglieder weiter: Sie überzeugt die hohe Rückvergütung, es gibt bei uns weder versteckte Kosten noch eine Aufnahmegebühr. Wir verdienen unser Geld mit dem, was wir können und lieben: Verhandeln, Qualität sichern, dauerhafte Geschäftsbeziehungen zu Lieferanten und Partnern aufbauen und halten.</p>
        </article>

        <div class="adv__dots" aria-label="Vorteil wählen">
          <button data-adv-go="0" class="is-active">01</button>
          <button data-adv-go="1">02</button>
          <button data-adv-go="2">03</button>
        </div>
      </div>
    </div>
  </div>
 </div>
 </div>
</section>

<!-- ============ SORTIMENT-SLIDER ============ -->
<section class="sort" aria-label="Aktuelles Sortiment">
  <div class="wrap">
    <div class="sort__bar">
      <div class="sort__tabs" role="tablist">
        <button role="tab" aria-selected="true" data-sort-tab="gastro">Gastro Sortiment</button>
        <button role="tab" aria-selected="false" data-sort-tab="shop">Shop Sortiment</button>
      </div>
      <div class="sort__nav">
        <span class="sort__count"><b data-sort-cur>1</b> / <span data-sort-total>4</span></span>
        <button class="iconbtn" data-sort-prev aria-label="Vorheriger Slide">←</button>
        <button class="iconbtn" data-sort-next aria-label="Nächster Slide">→</button>
      </div>
    </div>

    <div class="sort__stage" data-sort>
      {% for set in [["gastro", "slide"], ["shop", "shop"]] %}
      <div class="sort__track{% if loop.first %} is-active{% endif %}" data-sort-set="{{ set[0] }}">
        {% for i in [1, 2, 3, 4] %}
        <a href="{{ site.sortiment }}" class="sort__slide{% if loop.first %} is-active{% endif %}">
          <img src="/images/sortiment/{{ set[1] }}-{{ i }}.webp" alt="{{ 'Gastro' if set[0] == 'gastro' else 'Shop' }} Sortiment – Bester Preis im 4. Quartal 2026, Angebot {{ i }}" width="1920" height="838" loading="lazy">
        </a>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="sort__progress" aria-hidden="true"><span data-sort-progress></span></div>
    </div>
  </div>
</section>

<!-- ============ KUNDENSTIMMEN ============ -->
<section class="voices">
  <div class="wrap voices__head">
    <h2 class="h2 h2--xl" data-reveal>Kunden&shy;stimmen</h2>
  </div>
  <div class="voices__grid">
    {% for s in stimmen %}
    <figure class="reel" data-reel>
      <div class="reel__media">
        <video src="{{ site.videoBase }}{{ s.video }}#t=2" preload="metadata" playsinline></video>
        <button class="reel__play" aria-label="Video von {{ s.name }} abspielen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></button>
      </div>
      <figcaption>
        <h3>{{ s.name }}</h3>
        <p>{{ s.role }}</p>
      </figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

<!-- ============ LEISTUNGEN ============ -->
<section class="serv" id="leistungen">
  <div class="wrap">
    <div class="serv__head">
      <h2 class="h2 h2--xl" data-reveal>Leistungen</h2>
    </div>

    <div class="serv__grid">
      <div class="serv__acc" data-acc>
        <div class="acc is-open">
          <button class="acc__btn" aria-expanded="true">
            <span class="acc__no">01</span><span class="acc__title">Kaufmännische Leistungen</span><span class="acc__icon" aria-hidden="true"></span>
          </button>
          <div class="acc__panel"><div class="acc__inner">
            <p>Unsere Expertise: Als erfahrene Gastronomen optimieren wir Ihren Einkauf durch kaufmännisches Know-how, strikte Qualitätskontrollen und strategische Verhandlungen mit über 50 Top-Lieferanten. In der Praxis bedeutet das permanentes Marktscreening, regelmäßige Vergleiche der Ordersätze und jährliche Ausschreibungen. Damit unsere Mitglieder optimale Waren zu top Konditionen von besten Lieferanten bekommen. Besonders wichtig: die Zuverlässigkeit unserer Partner und Lieferanten in Sachen Logistik, Qualität und Preis. Vor Ort prüfen wir persönlich regelmäßig die Qualitäts- und Hygienestandards. Maßstab sind dabei immer auch unsere persönlichen hohen Ansprüche als langjährige Gastronomen.</p>
          </div></div>
        </div>
        <div class="acc">
          <button class="acc__btn" aria-expanded="false">
            <span class="acc__no">02</span><span class="acc__title">Große Ordervolumen für optimale Konditionen</span><span class="acc__icon" aria-hidden="true"></span>
          </button>
          <div class="acc__panel"><div class="acc__inner">
            <p>Für wen wir arbeiten: Wir unterstützen Systemgastronomen, Hoteliers, Tankstellenbetreiber und klassische Gastronomiebetriebe dabei, durch gebündelte Ordervolumen Bestkonditionen zu erzielen. Bei Verhandlungen bringt das gute Konditionen und spart bares Geld für unsere Mitglieder! Der direkte, seit Jahren gute Draht zu unseren Partnern und Lieferanten ist die Basis für unseren Erfolg. Denn nur wo Vertrauen ist, kommt und bleibt man gut miteinander im Geschäft. Das gilt für die Beziehungen zu unseren externen Partnern und Lieferanten genauso wie innerhalb der Mitgliedergemeinschaft.</p>
          </div></div>
        </div>
        <div class="acc">
          <button class="acc__btn" aria-expanded="false">
            <span class="acc__no">03</span><span class="acc__title">Marketing-Leistungen</span><span class="acc__icon" aria-hidden="true"></span>
          </button>
          <div class="acc__panel"><div class="acc__inner">
            <p>Zusätzliche Unterstützung: Wir helfen Ihnen, Ihren Umsatz zu steigern. Unser Kompetenzpool bietet spezialisierte Services in den Bereichen Ladenbau, Grafikdesign und digitales Marketing am Point of Sale. Hierfür verfügen wir über einen Kompetenzpool mit Spezialisten aus den Bereichen Ladenbau, Grafikdesign und Marketing. Wir bieten außerdem Trainings zu ausgewählten Operationsthemen.</p>
            <blockquote>„Besonders wichtig ist uns, unsere Mitglieder dafür zu sensibilisieren, wie wichtig der professionelle und personalisierte Auftritt vor Ort ist: Vereinfacht heißt das: Zu zeigen, dass man seine Kundschaft wahrnimmt, lässt sie wiederkommen. Personalisierte Speisekarten und Werbung bieten wir daher ebenso an wie digitale Werbung für den Point of Sale.“</blockquote>
          </div></div>
        </div>
      </div>

      <div class="serv__img" data-reveal>
        <img src="/images/team.webp" alt="Gastro Einkaufsgemeinschaft" width="1400" height="830" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- ============ KONTAKT ============ -->
<section class="contact" id="kontakt">
  <div class="wrap contact__grid">
    <div class="contact__info" data-reveal>
      <p class="eyebrow"><span class="dot"></span>Kontakt</p>
      <h2 class="h2 h2--xl">Gastro Einkaufs&shy;gemeinschaft</h2>
      <address>
        Osterhofener Str. 12<br>
        93055 Regensburg
      </address>
      <a href="tel:{{ site.phone }}" class="contact__tel">{{ site.phoneLabel }}</a>
      <a href="{{ site.funnel }}" class="btn btn--orange">Kostenfreie Potenzialanalyse vereinbaren <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>

    <form class="form" data-form data-reveal style="--d:.1s" novalidate>
      <div class="field field--full"><input id="f-firma" name="firma" placeholder=" " autocomplete="organization"><label for="f-firma">Firma</label></div>
      <div class="field"><input id="f-vn" name="vorname" placeholder=" " autocomplete="given-name"><label for="f-vn">Vorname</label></div>
      <div class="field"><input id="f-nn" name="nachname" placeholder=" " autocomplete="family-name"><label for="f-nn">Nachname</label></div>
      <div class="field"><input id="f-tel" name="telefon" type="tel" placeholder=" " autocomplete="tel"><label for="f-tel">Telefon</label></div>
      <div class="field"><input id="f-mail" name="email" type="email" placeholder=" " autocomplete="email" required><label for="f-mail">E-Mail</label></div>
      <div class="field field--full"><textarea id="f-msg" name="anliegen" rows="4" placeholder=" "></textarea><label for="f-msg">Ihr Anliegen</label></div>
      <button type="submit" class="btn btn--green form__submit">Formular absenden <span class="btn__arrow" aria-hidden="true">→</span></button>
      <p class="form__ok" data-form-ok hidden>Vielen Dank! Wir melden uns in Kürze bei Ihnen.</p>
    </form>
  </div>
</section>

</main>

<!-- ============ FOOTER ============ -->
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo"><img src="/images/logo-white.png" alt="Gastro Einkaufsgemeinschaft" width="500" height="208" loading="lazy"></a>
      <a href="{{ site.funnel }}" class="btn btn--orange">Kostenfreie Potenzialanalyse vereinbaren <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="ftr__mid">
      <div>
        <h4>Gastro Einkaufsgemeinschaft</h4>
        <p>Osterhofener Str. 12<br>93055 Regensburg</p>
      </div>
      <div>
        <a href="tel:{{ site.phone }}" class="ftr__tel">{{ site.phoneLabel }}</a>
      </div>
      <nav class="ftr__nav" aria-label="Footer">
        <a href="/#ueber-uns">Über uns</a>
        <a href="/#vorteile">Vorteile</a>
        <a href="/#leistungen">Leistungen</a>
        <a href="/#kontakt">Kontakt</a>
      </nav>
    </div>
    <div class="ftr__bottom">
      <div class="ftr__legal">
        <a href="https://gastro-einkaufsgemeinschaft.de/impressum">Impressum</a>
        <a href="https://gastro-einkaufsgemeinschaft.de/datenschutz">Datenschutz</a>
      </div>
      <a href="http://www.aranes.de" class="ftr__credit">Webdesign by ARANES GmbH &amp; Co. KG</a>
    </div>
  </div>
</footer>

<script src="/js/main.js?v={% assetHash 'src/js/main.js' %}" defer></script>
</body>
</html>
